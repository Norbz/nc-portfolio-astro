---
import { Icon } from "astro-icon/components";
import TwoColumnsSection from "../common/TwoColumnsSection.astro";
import HardwareCard from "./hardware/HardwareCard.astro";
import {
    computeHardwareCO2ForProject,
    computeServiceCO2ForProject,
    computeServiceEnergyForProject,
    round,
} from "../../utils/co2";

interface TeamMember {
    role: string;
    share: number;
    days: number;
    comment?: string;
    url?: string;
}

interface Props {
    hardwareItems: any[];
    servicesItems: any[];
    durationDays: number;
    referenceDate: Date;
    team?: TeamMember[];
}
const {
    hardwareItems,
    servicesItems,
    durationDays,
    referenceDate,
    team = [],
} = Astro.props;

const hardwareKg = hardwareItems.reduce(
    (sum, h) =>
        sum + computeHardwareCO2ForProject(h.data, durationDays, referenceDate),
    0,
);
const servicesKg =
    servicesItems.reduce(
        (sum, s) => sum + computeServiceCO2ForProject(s.data, durationDays),
        0,
    ) / 1000;

// Team members are estimated from my own footprint per working day,
// scaled by their share and the days they worked.
const myDailyKg = (hardwareKg + servicesKg) / durationDays;
const teamItems = team.map((member) => ({
    ...member,
    kg: myDailyKg * member.share * member.days,
}));
const teamKg = teamItems.reduce((sum, m) => sum + m.kg, 0);

const totalKg = round(hardwareKg + servicesKg + teamKg, 3);

// Breakdown values under 1 kg are shown in grams, so small totals do not round to 0.
const formatKg = (kg: number) =>
    kg >= 1 ? `${round(kg, 1)} kg` : `${Math.round(kg * 1000)} g`;
---

<TwoColumnsSection titleLevel={2}>
    <span slot="title">Build<br />footprint</span>

    <div class="embodied-content">
        <p class="section-intro">
            The build footprint, called embodied CO₂, covers a prorated share
            of the lifecycle emissions (manufacturing, and use during
            development) of the hardware and services that went into building
            this project. Keeping hardware longer reduces it.
        </p>

        <p class="methodology-note">
            Each device's lifecycle CO₂ comes from its manufacturer's
            environmental report, adjusted where needed, and is spread over an
            estimated professional lifespan (200 working days per year). Once a
            device outlives that estimate, the calculation uses its actual age,
            and its daily cost keeps decreasing. The use phase is recalculated
            from each device's power draw at the French grid mix (ADEME).
        </p>

        <div class="hardware-list">
            {
                hardwareItems.map((device) => (
                    <HardwareCard
                        hardware={device.data}
                        durationDays={durationDays}
                        referenceDate={referenceDate}
                    />
                ))
            }
        </div>

        {
            servicesItems.length > 0 && (
                <div class="services-block">
                    <h3>Services</h3>
                    <ul class="services-list">
                        {servicesItems.map((service) => (
                            <li class="service-item">
                                <Icon name={service.data.icon} size="20" />
                                <div class="service-info">
                                    <span class="service-name">
                                        {service.data.name}
                                    </span>
                                    <span class="service-desc">
                                        {service.data.description}
                                    </span>
                                    {service.data.comments && (
                                        <span class="service-methodology">
                                            {service.data.comments}
                                        </span>
                                    )}
                                </div>
                                <div class="service-metrics">
                                    <span class="service-co2">
                                        {round(
                                            computeServiceCO2ForProject(
                                                service.data,
                                                durationDays,
                                            ),
                                            1,
                                        )}{" "}
                                        g CO₂
                                    </span>
                                    {service.data.kwh_per_month && (
                                        <span class="service-kwh">
                                            {round(
                                                computeServiceEnergyForProject(
                                                    service.data,
                                                    durationDays,
                                                ),
                                                2,
                                            )}{" "}
                                            kWh
                                        </span>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }

        {
            teamItems.length > 0 && (
                <div class="services-block">
                    <h3>Team</h3>
                    <p class="team-note">Team members' footprints are estimated.</p>
                    <ul class="services-list">
                        {teamItems.map((member) => (
                            <li class="service-item">
                                <Icon name="lucide:user" size="20" />
                                <div class="service-info">
                                    {member.url ? (
                                        <a
                                            href={member.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="service-name team-link"
                                        >
                                            {member.role}{" "}
                                            <Icon name="lucide:external-link" size="12" />
                                        </a>
                                    ) : (
                                        <span class="service-name">
                                            {member.role}
                                        </span>
                                    )}
                                    {member.comment && (
                                        <span class="service-methodology">
                                            {member.comment}
                                        </span>
                                    )}
                                </div>
                                <div class="service-metrics">
                                    <span class="service-co2">
                                        {formatKg(member.kg)} CO₂
                                    </span>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }

        <div class="total-bar">
            <span class="total-label">Total embodied</span>
            <span class="total-value">{totalKg} kg CO₂</span>
            <span class="total-services">
                Hardware {formatKg(hardwareKg)} · services {formatKg(servicesKg)}
                {teamItems.length > 0 && ` · team ${formatKg(teamKg)}`}
            </span>
        </div>
    </div>
</TwoColumnsSection>

<style lang="scss">
    .embodied-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .section-intro {
        font-size: 1.2rem;
        max-width: 600px;
    }

    .methodology-note {
        font-size: 0.9rem;
        opacity: 0.7;
        font-style: italic;
        max-width: 600px;
        margin-top: -1rem;
    }

    .hardware-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .services-block {
        h3 {
            font-size: 1.2rem;
            margin-bottom: 1rem;
        }

        .team-link {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            color: var(--textColor);
            width: fit-content;
        }

        .team-note {
            font-size: 0.9rem;
            opacity: 0.7;
            font-style: italic;
            margin: -0.5rem 0 1rem;
        }
    }

    .services-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        border: $border;
        box-shadow: $shadow;
    }

    .service-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: $border;
        background: var(--mainColor);

        &:last-child {
            border-bottom: none;
        }

        .service-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;

            .service-name {
                font-size: 1rem;
            }

            .service-desc {
                font-size: 0.8rem;
                opacity: 0.6;
            }

            .service-methodology {
                font-size: 0.75rem;
                opacity: 0.5;
                font-style: italic;
                margin-top: 0.2rem;
            }
        }

        .service-metrics {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 0.25rem;
            flex-shrink: 0;
        }

        .service-co2 {
            font-size: 0.85rem;
            font-variant-numeric: tabular-nums;
            @include set-color(true);
            padding: 0.15rem 0.5rem;
        }

        .service-kwh {
            font-size: 0.8rem;
            font-variant-numeric: tabular-nums;
            opacity: 0.6;
        }
    }

    .total-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        border: $border;
        box-shadow: $shadow;
        padding: 1rem 1.5rem;
        @include set-color(true);
        flex-wrap: wrap;

        .total-label {
            opacity: 0.6;
            font-size: 0.9rem;
            flex-grow: 1;
        }

        .total-value {
            font-size: 1.4rem;
            font-variant-numeric: tabular-nums;
        }

        .total-services {
            font-size: 0.85rem;
            opacity: 0.7;
        }
    }
</style>
