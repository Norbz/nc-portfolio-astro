---
import { Icon } from "astro-icon/components";
const { className } = Astro.props;

const icon = "lucide:copy";
---

<button
    client.visible
    class={`email-button ${className}`}
    data-email="hello"
    data-domain="nicolaschesne.fr"
    data-umami-event="contact"
>
    <div class="action">
        {/*
            Cloudflare Email Obfuscation rewrites plain addresses to
            "[email protected]" and decodes them only on a full page load.
            Pages fetched by the ClientRouter stay encoded, so this address
            is excluded from obfuscation.
        */}
        <!--email_off--><span>hello@nicolaschesne.fr</span><!--/email_off-->
        <Icon name={icon} size="24" />
    </div>
    <span class="result" client.visible>Copied to clipboard!</span>
</button>

<script>
    // The ClientRouter swaps the body on navigation, so listeners are bound
    // again on each page load. data-bound skips buttons already bound.
    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>(".email-button:not([data-bound])")
            .forEach((btn) => {
                btn.dataset.bound = "";
                btn.addEventListener("click", () => {
                    const email = `${btn.dataset.email}@${btn.dataset.domain}`;
                    navigator.clipboard.writeText(email).then(() => {
                        btn.classList.add("copied");
                        setTimeout(() => {
                            btn.classList.remove("copied");
                        }, 2000);
                    });
                });
            });
    });
</script>

<style lang="scss">
    .email-button {
        position: relative;
        font-family: $mainFont;
        font-size: 1.2rem;
        padding: 1rem;
        box-shadow: $shadow;
        border: $border;
        @include set-color();
        margin: auto;
        cursor: pointer;
        &:hover {
            @include set-color(true);
        }

        &.inverted {
            @include set-color(true);
            box-shadow: none;
            border: none;
        }
        &:hover.inverted {
            @include set-color();
        }

        .action {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: center;
        }

        .result {
            opacity: 0;
            padding: 0 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--textColor);
            color: var(--mainColor);
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, 0);
            width: max-content;
            transition: all 0.2s ease-in-out;
        }

        &.copied {
            color: var(--mainColor);
            background: var(--textColor);

            .action {
                opacity: 0;
                transform: translateY(-50%);
            }
            .result {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }
    }
</style>
